/// What-if parameter for the contact-strategy simulator.
table 'Attempt Cap'

	/// Maximum calls per client in the simulation
	column 'Attempt Cap'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Attempt Cap' = calculated
		mode: import
		source =
				GENERATESERIES(1, 15, 1)

