/// Client profile at the time of the campaign (one row per client record).
table Client

	column ClientKey
		dataType: int64
		isKey
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ClientKey

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Age

	/// Age group
	column AgeBand
		dataType: string
		summarizeBy: none
		sourceColumn: AgeBand
		sortByColumn: AgeBandOrder

	column AgeBandOrder
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: AgeBandOrder

	column Job
		dataType: string
		summarizeBy: none
		sourceColumn: Job

	column Marital
		dataType: string
		summarizeBy: none
		sourceColumn: Marital

	column Education
		dataType: string
		summarizeBy: none
		sourceColumn: Education
		sortByColumn: EducationOrder

	column EducationOrder
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: EducationOrder

	/// Has credit in default
	column CreditDefault
		dataType: string
		summarizeBy: none
		sourceColumn: CreditDefault

	column HousingLoan
		dataType: string
		summarizeBy: none
		sourceColumn: HousingLoan

	column PersonalLoan
		dataType: string
		summarizeBy: none
		sourceColumn: PersonalLoan

	partition Client = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("dim_client.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"ClientKey", Int64.Type}, {"Age", Int64.Type}, {"AgeBand", type text}, {"AgeBandOrder", Int64.Type}, {"Job", type text}, {"Marital", type text}, {"Education", type text}, {"EducationOrder", Int64.Type}, {"CreditDefault", type text}, {"HousingLoan", type text}, {"PersonalLoan", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
