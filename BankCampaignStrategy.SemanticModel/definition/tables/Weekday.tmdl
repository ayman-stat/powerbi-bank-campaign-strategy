/// Weekday of the last contact.
table Weekday

	column WeekdayNum
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: WeekdayNum

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: WeekdayNum

	partition Weekday = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("dim_weekday.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"WeekdayNum", Int64.Type}, {"Weekday", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
